// La copia de la clienta, en Cloudflare: Workers Builds conectado a su repo.
// Se publica en la raíz; con el dominio en data/site.json → "url", se indexa.
// Workers Builds hace el npm install solo (sharp).
{
  "name": "sepulcrito",
  "compatibility_date": "2026-11-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
